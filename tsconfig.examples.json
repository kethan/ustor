{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": false
	},
	"include": [
		"examples/preact-setup.mjs",
		"examples/typescript/**/*.ts",
		"examples/react/**/*.jsx",
		"examples/nextjs/**/*.jsx"
	]
}
