{
	"name": "ustor",
	"description": "A tiny, dependency-free reactive store with pluggable signal adapters and optional React hooks.",
	"version": "0.1.0",
	"type": "module",
	"source": "./src/index.js",
	"types": "./types/index.d.ts",
	"main": "./dist/index.cjs",
	"module": "./dist/index.es.js",
	"unpkg": "./dist/index.min.js",
	"umd:main": "./dist/index.umd.js",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"browser": "./dist/index.es.js",
			"import": "./dist/index.es.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.es.js"
		},
		"./react": {
			"types": "./types/react.d.ts",
			"import": "./dist/react.es.js",
			"require": "./dist/react.cjs",
			"default": "./dist/react.es.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kethan/ustor.git"
	},
	"files": [
		"dist",
		"types"
	],
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && rollup --config rollup.config.js",
		"test": "npm run build && npm run typecheck && vitest --run && node test.package.cjs",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.nodenext.json",
		"test:watch": "vitest",
		"test:coverage": "vitest --run --coverage",
		"profile": "node --expose-gc scripts/profile.mjs",
		"profile:smoke": "node --expose-gc scripts/profile.mjs --updates=5000 --array-updates=500 --seconds=0.5 --cycles=500 --sample-ms=100",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@preact/signals-core": "^1.14.4",
		"@rollup/plugin-terser": "^1.0.2",
		"@tanstack/store": "^0.11.2",
		"@vitest/coverage-v8": "^5.0.5",
		"@vue/reactivity": "^3.5.44",
		"@webreflection/alien-signals": "^0.4.2",
		"@webreflection/signal": "^2.1.2",
		"@webreflection/signals": "^0.2.8",
		"alien-signals": "^3.2.1",
		"jsdom": "^30.1.3",
		"mobx": "^7.1.1",
		"nanostores": "^1.5.5",
		"oby": "^15.1.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rollup": "^4.65.0",
		"rollup-plugin-bundle-size": "^1.0.3",
		"rxjs": "^7.8.2",
		"s-js": "^0.4.9",
		"sinuous": "^0.32.1",
		"solid-js": "^1.9.17",
		"typescript": "^7.0.2",
		"ulive": "^1.0.7",
		"usignal": "^0.10.0",
		"vitest": "^5.0.5"
	},
	"keywords": [
		"ustor",
		"ustore",
		"store",
		"signal",
		"createmutable",
		"mutable",
		"createstore",
		"solid.js",
		"state",
		"observable",
		"reactive"
	],
	"author": "Kethan Surana",
	"license": "MIT",
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"bugs": {
		"url": "https://github.com/kethan/ustor/issues"
	},
	"homepage": "https://github.com/kethan/ustor#readme"
}
